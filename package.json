{
  "name": "tailwindplus-downloader",
  "version": "3.4.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0"
  },
  "description": "A downloader for TailwindPlus components with diff comparison tools",
  "author": "Richard Michael",
  "license": "MIT",
  "files": [
    "tailwindplus-downloader.js",
    "tailwindplus-diff.js",
    "scripts/create-skeleton.sh"
  ],
  "bin": {
    "tailwindplus-downloader": "tailwindplus-downloader.js",
    "tailwindplus-diff": "tailwindplus-diff.js",
    "twp-downloader": "tailwindplus-downloader.js",
    "twp-diff": "tailwindplus-diff.js",
    "twp-create-skeleton": "scripts/create-skeleton.sh"
  },
  "dependencies": {
    "playwright": "^1.62.1",
    "read": "^6.0.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0"
  },
  "scripts": {
    "postinstall": "npx playwright install --with-deps chromium",
    "test": "npm run test:unit && npm run smoke-test",
    "lint": "eslint --config eslint.config.cjs \"**/*.js\"",
    "lint:fix": "eslint --config eslint.config.cjs \"**/*.js\" --fix",
    "create-skeleton": "bash scripts/create-skeleton.sh",
    "smoke-test": "bash test/smoke-test.sh",
    "test:unit": "node --test test/*.test.js"
  }
}
